{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure Space Fighters",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}\\Space_Fighters_(SFML)",
                "-B",
                "${workspaceFolder}\\Space_Fighters_(SFML)\\build",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build Space Fighters",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}\\Space_Fighters_(SFML)\\build",
                "--config",
                "Debug"
            ],
            "dependsOrder": "sequence",
            "dependsOn": "Configure Space Fighters",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Run Space Fighters",
            "type": "process",
            "command": "${workspaceFolder}\\Space_Fighters_(SFML)\\build\\bin\\SpaceFighters.exe",
            "options": {
                "cwd": "${workspaceFolder}\\Space_Fighters_(SFML)"
            },
            "problemMatcher": []
        },
        {
            "label": "Build and Run Space Fighters",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build Space Fighters",
                "Run Space Fighters"
            ],
            "problemMatcher": []
        }
    ]
}
