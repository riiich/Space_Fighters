{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Space Fighters (Visual Studio)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\Space_Fighters_(SFML)\\build\\bin\\SpaceFighters.exe",
            "args": [],
            "cwd": "${workspaceFolder}\\Space_Fighters_(SFML)",
            "stopAtEntry": false
        },
        {
            "name": "Debug Space Fighters (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\Space_Fighters_(SFML)\\build\\bin\\SpaceFighters.exe",
            "args": [],
            "cwd": "${workspaceFolder}\\Space_Fighters_(SFML)",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
