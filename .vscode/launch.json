{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Debug Space Fighters",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\Space_Fighters_(SFML)\\SpaceFighters.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}\\Space_Fighters_(SFML)",
            "environment": [],
            "externalConsole": true,
            "avoidWindowsConsoleRedirection": true,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\MinGW\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
